# --- MySQL ---------------------------------------------------------------
MYSQL_DATABASE=flight_booking
MYSQL_USER=flight_user
MYSQL_PASSWORD=flight_password
MYSQL_ROOT_PASSWORD=root_password

# Inside Docker Django reaches MySQL at db:3306 (NOT localhost)
DB_HOST=db
DB_PORT=3306

# --- Django --------------------------------------------------------------
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TIME_ZONE=Asia/Phnom_Penh
BOOKING_TAX_RATE=0.10

# Load demo data automatically on first start (skipped when data already exists)
AUTO_SEED=true

# --- Next.js -------------------------------------------------------------
# The browser calls the API, so this must be reachable from your machine
NEXT_PUBLIC_API_URL=http://localhost:8000/api
